FROM gradle:jdk21 AS builder
WORKDIR /build
USER root

COPY gradle.properties settings.gradle build.gradle.kts ./
COPY gradlew gradlew.bat ./
COPY gradle gradle/
COPY buildSrc buildSrc/

COPY services/ai/build.gradle.kts services/ai/build.gradle.kts
COPY services/article/build.gradle.kts services/article/build.gradle.kts
COPY services/auth/build.gradle.kts services/auth/build.gradle.kts
COPY services/category/build.gradle.kts services/category/build.gradle.kts
COPY services/chapter/build.gradle.kts services/chapter/build.gradle.kts
COPY services/common/build.gradle.kts services/common/build.gradle.kts
COPY services/content/build.gradle.kts services/content/build.gradle.kts
COPY services/course/build.gradle.kts services/course/build.gradle.kts
COPY services/graph/build.gradle.kts services/graph/build.gradle.kts
COPY services/learning/build.gradle.kts services/learning/build.gradle.kts
COPY services/quiz/build.gradle.kts services/quiz/build.gradle.kts
COPY services/resource/build.gradle.kts services/resource/build.gradle.kts
COPY services/search/build.gradle.kts services/search/build.gradle.kts
COPY services/user/build.gradle.kts services/user/build.gradle.kts
COPY server/build.gradle.kts server/build.gradle.kts

RUN for d in services/*/ server/; do mkdir -p "$d/src/main/java" "$d/src/main/resources"; done

RUN ./gradlew dependencies --no-daemon 2>&1

COPY services services/
COPY server server/

RUN ./gradlew bootJar -x test -x compileTestJava -x processTestResources --no-daemon

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S -G app app
COPY --from=builder /build/server/build/libs/*.jar app.jar
EXPOSE 9000
USER app
ENTRYPOINT ["java", "-jar", "/app.jar"]
